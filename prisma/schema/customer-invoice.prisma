
enum InvoiceStatus {
    DRAFT         // auto-created after quote approval, not sent yet
    OPEN          // sent to customer, awaiting payment
    PARTIAL       // at least one installment paid, more remain
    PAID          // fully paid
    OVERDUE       // past due date, unpaid
    VOID          // cancelled by admin
    UNCOLLECTIBLE // written off
}

enum InstallmentStatus {
    PENDING  // not yet sent — waiting for previous installment to be paid
    SENT     // Stripe invoice created + payment link sent to customer
    PAID     // customer paid this installment
    OVERDUE  // past due date, not paid
}

model CustomerInvoice {
    id            String @id @default(uuid())
    invoiceNumber String @unique 

    customerId    String
    customer      Customer    @relation(fields: [customerId], references: [id])
    quoteId       String?     
    quote         Quote?      @relation(fields: [quoteId], references: [id])
    paymentTermId String?     // e.g. "Net 30", "50% Deposit" — admin selects
    paymentTerm   PaymentTerm? @relation(fields: [paymentTermId], references: [id])
    stripeCustomerId String? 
    stripeInvoiceId  String? @unique
    hostedInvoiceUrl String? 
    invoicePdfUrl    String? 
    subtotal   Decimal @db.Decimal(10, 2)
    discount   Decimal @default(0.00) @db.Decimal(10, 2)
    taxRate    Decimal @default(7.00) @db.Decimal(5, 2)
    taxAmount  Decimal @default(0.00) @db.Decimal(10, 2)
    total      Decimal @db.Decimal(10, 2) 
    amountPaid Decimal @default(0.00) @db.Decimal(10, 2) 
    amountDue  Decimal @db.Decimal(10, 2) 

    status InvoiceStatus @default(DRAFT)
    sentAt DateTime?    
    paidAt DateTime?   
    dueDate DateTime?    
    notes String? @db.Text 
    lineItems    InvoiceLineItem[]
    installments InvoiceInstallment[] 
    payments     Payment[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model InvoiceLineItem {
    id        String          @id @default(uuid())
    invoiceId String
    invoice   CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

    description String
    quantity    Int     @default(1)
    unitPrice   Decimal @db.Decimal(10, 2)
    total       Decimal @db.Decimal(10, 2) // quantity * unitPrice

    createdAt DateTime @default(now())
}


model InvoiceInstallment {
    id        String          @id @default(uuid())
    invoiceId String
    invoice   CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

    installmentNumber Int     
    label             String 
    percentAmount     Decimal @db.Decimal(5, 2)  
    amount            Decimal @db.Decimal(10, 2) 

    dueDate DateTime? 

    stripeInvoiceId  String? @unique 
    hostedInvoiceUrl String? 
    invoicePdfUrl    String?

    status InstallmentStatus @default(PENDING)
    sentAt DateTime?      
    paidAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([invoiceId, installmentNumber])
}


model Payment {
    id        String          @id @default(uuid())
    invoiceId String
    invoice   CustomerInvoice @relation(fields: [invoiceId], references: [id])
    customerId String
    customer  Customer        @relation(fields: [customerId], references: [id])

    stripePaymentIntentId String? 
    stripeChargeId        String? 
    stripeEventId         String? @unique 

    amount        Decimal @db.Decimal(10, 2)
    currency      String  @default("USD")
    status        String 
    paymentMethod String? 
    paidAt        DateTime?

    createdAt DateTime @default(now())
}
