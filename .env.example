# =============================================================================
# PART 1: CORE / INTERNAL CONFIGURATION
# =============================================================================

# ── App Configuration ──────────────────────────────── 
NODE_ENV=development 
APP_NAME=aimalya 
APP_PORT=3000 
API_PREFIX=api/v1 
FRONTEND_DOMAIN=http://localhost:5173 
BACKEND_DOMAIN=http://localhost:3000 

# ── Shop Information ─────────────────────────────────
SHOP_NAME=Francys 

# ── Database Configuration ─────────────────────────── 
DATABASE_URL=postgresql://postgres:changeme@localhost:5433/mydb?schema=public 

# Local/Fallback Postgres details 
POSTGRES_USER=postgres 
POSTGRES_PASSWORD=changeme 
POSTGRES_DB=mydb 
POSTGRES_HOST_PORT=5433 

# ── PgAdmin Configuration ────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5051

# ── Admin Initial Credentials ─────────────────────────
SUPER_ADMIN_EMAIL=superadmin@example.com 
SUPER_ADMIN_PASSWORD=change_this_admin_password_123 

# ── JWT Authentication Configuration ─────────────────
# Replace these secrets with strong random strings in production!
JWT_SECRET=your_jwt_secret_key_change_me_in_production 
JWT_EXPIRES_IN=1h 
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_me_in_production 
JWT_REFRESH_EXPIRES_IN=7d 


# =============================================================================
# PART 2: THIRD-PARTY INTEGRATION CONFIGURATION (External Provider API Keys)
# =============================================================================

# ── Mail Configuration (SMTP / Gmail) ────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password

# ── Cloudinary Configuration (Image & Asset Storage) ──
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Google OAuth & Email Tracker Configuration ───────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_PUB_SUB_TOPIC=projects/your_project_id/topics/gmail-notifications
GOOGLE_USER_ACCESS_TOKEN=your_google_access_token
GOOGLE_USER_REFRESH_TOKEN=your_google_refresh_token

# ── WhatsApp Business Cloud API Configuration ─────────
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token
WHATSAPP_APP_ID=your_whatsapp_app_id
WHATSAPP_APP_SECRET=your_whatsapp_app_secret
