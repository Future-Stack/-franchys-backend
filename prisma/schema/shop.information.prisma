model ShopInformation {
    shopId         String  @id @default(uuid())
    shopIdentifier String  @unique
    companyName    String?
    companyEmail   String?
    address        String?
    city           String?
    state          String?
    zip            String?
    country        String?
    phone          String?
    website        String?
    companyLogo    String?
    facebook       String?
    whatsapp       String?
    tiktok         String?
    instagram      String?
}
