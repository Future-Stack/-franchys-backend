// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum InvoiceStatus {
    DRAFT         // auto-created after quote approval, not sent yet
    OPEN          // sent to customer, awaiting payment
    PARTIAL       // at least one installment paid, more remain
    PAID          // fully paid
    OVERDUE       // past due date, unpaid
    VOID          // cancelled by admin
    UNCOLLECTIBLE // written off
}

enum InstallmentStatus {
    PENDING  // not yet sent — waiting for previous installment to be paid
    SENT     // Stripe invoice created + payment link sent to customer
    PAID     // customer paid this installment
    OVERDUE  // past due date, not paid
}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMER INVOICE
// The main invoice record. Created automatically when quote is APPROVED.
// Admin reviews it (DRAFT), then sends it (OPEN).
// ─────────────────────────────────────────────────────────────────────────────

model CustomerInvoice {
    id            String @id @default(uuid())
    invoiceNumber String @unique // INV-1001, INV-1002 — generated from invoiceSeed

    // Relations
    customerId    String
    customer      Customer    @relation(fields: [customerId], references: [id])
    quoteId       String?     // which quote triggered this invoice
    quote         Quote?      @relation(fields: [quoteId], references: [id])
    paymentTermId String?     // e.g. "Net 30", "50% Deposit" — admin selects
    paymentTerm   PaymentTerm? @relation(fields: [paymentTermId], references: [id])

    // Stripe fields
    stripeCustomerId String? // "cus_xxxx" — stored for convenience
    // For FULL payment: single Stripe invoice lives here
    // For PARTIAL payment: each InvoiceInstallment has its own stripeInvoiceId
    stripeInvoiceId  String? @unique // "in_xxxx" — only set for full (non-installment) invoices
    hostedInvoiceUrl String? // URL sent to customer — for full payment only
    invoicePdfUrl    String? // Stripe PDF — for full payment only

    // Amounts — always reflect the FULL order total
    subtotal   Decimal @db.Decimal(10, 2)
    discount   Decimal @default(0.00) @db.Decimal(10, 2)
    taxRate    Decimal @default(7.00) @db.Decimal(5, 2)
    taxAmount  Decimal @default(0.00) @db.Decimal(10, 2)
    total      Decimal @db.Decimal(10, 2) // the full order total, never changes
    amountPaid Decimal @default(0.00) @db.Decimal(10, 2) // sum of all paid installments
    amountDue  Decimal @db.Decimal(10, 2) // = total - amountPaid, starts equal to total

    // Status & dates
    status InvoiceStatus @default(DRAFT)
    sentAt DateTime?     // when invoice (or first installment) was sent
    paidAt DateTime?     // when fully paid
    dueDate DateTime?    // due date (for full payment, or last installment)

    notes String? @db.Text // admin internal notes

    // Child records
    lineItems    InvoiceLineItem[]
    installments InvoiceInstallment[] // empty for full payment, has records for partial
    payments     Payment[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// INVOICE LINE ITEMS
// Copied from QuoteLineItem when invoice is auto-created from quote.
// Admin can edit before sending.
// ─────────────────────────────────────────────────────────────────────────────

model InvoiceLineItem {
    id        String          @id @default(uuid())
    invoiceId String
    invoice   CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

    description String
    quantity    Int     @default(1)
    unitPrice   Decimal @db.Decimal(10, 2)
    total       Decimal @db.Decimal(10, 2) // quantity * unitPrice

    createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// INVOICE INSTALLMENTS
// Used ONLY when a partial-payment PaymentTerm is selected (depositPercent set).
// e.g. "50% pay now + 50% net 30" creates 2 installments.
// Each installment gets its own Stripe invoice and hosted_invoice_url.
// Installment #2+ are PENDING until the previous one is PAID (via webhook).
// ─────────────────────────────────────────────────────────────────────────────

model InvoiceInstallment {
    id        String          @id @default(uuid())
    invoiceId String
    invoice   CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

    installmentNumber Int     // 1, 2, 3...
    label             String  // "Deposit (50%)", "Balance (50%)"
    percentAmount     Decimal @db.Decimal(5, 2)  // e.g. 50.00
    amount            Decimal @db.Decimal(10, 2) // actual dollar amount for this installment

    dueDate DateTime? // when this installment is due

    // Each installment has its OWN Stripe invoice
    stripeInvoiceId  String? @unique // "in_xxxx"
    hostedInvoiceUrl String? // send this to customer — never expires!
    invoicePdfUrl    String?

    status InstallmentStatus @default(PENDING)
    sentAt DateTime?         // when payment link was sent to customer
    paidAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([invoiceId, installmentNumber])
}

// ─────────────────────────────────────────────────────────────────────────────
// PAYMENTS
// Created by Stripe webhook (invoice.payment_succeeded).
// One record per successful payment — tracks installments and full payments.
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
    id        String          @id @default(uuid())
    invoiceId String
    invoice   CustomerInvoice @relation(fields: [invoiceId], references: [id])
    customerId String
    customer  Customer        @relation(fields: [customerId], references: [id])

    // Stripe fields (from webhook event)
    stripePaymentIntentId String? // "pi_xxxx"
    stripeChargeId        String? // "ch_xxxx"
    stripeEventId         String? @unique // "evt_xxxx" — idempotency key, prevents duplicates

    amount        Decimal @db.Decimal(10, 2)
    currency      String  @default("USD")
    status        String  // "succeeded", "failed", "pending", "refunded"
    paymentMethod String? // "card", "bank_transfer", etc.
    paidAt        DateTime?

    createdAt DateTime @default(now())
}
