model PriceMatrix {
  priceMatrixId String      @id @default(uuid())
  name          String
  priceType     String
  priceTiers    PriceTier[]
}

model PriceTier {
  priceTierId   String      @id @default(uuid())
  quantity      Int
  basePrice     Decimal     @db.Decimal(10, 2)
  markup        Decimal     @db.Decimal(10, 2)
  priceMatrixId String
  priceMatrix   PriceMatrix @relation(fields: [priceMatrixId], references: [priceMatrixId], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  createAt  DateTime @default(now())

  @@index([priceMatrixId])
}
