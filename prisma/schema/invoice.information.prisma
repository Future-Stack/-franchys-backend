model InvoiceInformation {
    iniId String @id @default(uuid())

    // Basic settings
    currency       String  @default("USD")
    language       String  @default("English")
    invoiceTaxRate Decimal @default(7.00) @db.Decimal(5, 2)
    invoiceSeed    Int     @default(1)

    // Text content shown on invoices & public pages
    invoiceCommentary        String? @db.Text 
    termsAndCondition        String  @db.Text 
    refundPolicy             String? @db.Text 
    deliveryPolicy           String? @db.Text 
    paymentTramsAndCondition String? @db.Text 

    showTotalQuantity   Boolean @default(true)
    makeImprintsVisible Boolean @default(true)
    showPoNumber        Boolean @default(true)

    printingLayout  String @default("PORTRAIT")        
    invoicePrivacy  String @default("ANYONE_WITH_LINK")  

    updatedAt DateTime @updatedAt
    createAt  DateTime @default(now())
}
