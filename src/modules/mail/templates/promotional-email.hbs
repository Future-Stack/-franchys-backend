<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{subject}}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background-color: #f4f6f9;
      color: #333333;
      line-height: 1.6;
    }
    .wrapper {
      max-width: 600px;
      margin: 40px auto;
      background: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }
    .header {
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      padding: 36px 32px;
      text-align: center;
    }
    .header h1 {
      color: #ffffff;
      font-size: 24px;
      font-weight: 800;
      letter-spacing: 1px;
      margin: 0;
    }
    .header p {
      color: rgba(255,255,255,0.75);
      font-size: 14px;
      margin-top: 6px;
    }
    .body {
      padding: 36px 32px;
    }
    .greeting {
      font-size: 18px;
      font-weight: 600;
      color: #1a1a2e;
      margin-bottom: 16px;
    }
    .content-box {
      font-size: 15px;
      color: #4b5563;
      margin-bottom: 24px;
      line-height: 1.7;
    }
    .content-box p {
      margin-bottom: 12px;
    }
    .content-box ul, .content-box ol {
      margin: 12px 0 12px 24px;
    }
    .promo-card {
      background: #f0f7ff;
      border: 2px dashed #2563eb;
      border-radius: 10px;
      padding: 20px;
      text-align: center;
      margin: 28px 0;
    }
    .promo-card .label {
      font-size: 12px;
      font-weight: 700;
      color: #2563eb;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 6px;
    }
    .promo-card .code {
      font-size: 26px;
      font-weight: 800;
      color: #1e293b;
      letter-spacing: 2px;
      font-family: monospace;
    }
    .cta-wrapper {
      text-align: center;
      margin: 32px 0 16px 0;
    }
    .cta-btn {
      display: inline-block;
      background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
      color: #ffffff !important;
      text-decoration: none;
      font-size: 16px;
      font-weight: 700;
      padding: 14px 36px;
      border-radius: 8px;
      box-shadow: 0 4px 12px rgba(37,99,235,0.25);
    }
    .divider {
      border: none;
      border-top: 1px solid #e5e7eb;
      margin: 28px 0;
    }
    .footer {
      background: #f8fafc;
      padding: 24px 32px;
      text-align: center;
      border-top: 1px solid #e2e8f0;
    }
    .footer p {
      font-size: 12px;
      color: #94a3b8;
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      {{#if shopLogoUrl}}
        <img src="{{shopLogoUrl}}" alt="Logo" style="max-height: 52px; max-width: 200px; margin-bottom: 12px; display: inline-block; object-fit: contain;" />
        <br />
      {{/if}}
      <h1>{{title}}</h1>
      <p>{{shopName}}</p>
    </div>

    <div class="body">
      <p class="greeting">Hi {{customerName}},</p>

      <div class="content-box">
        {{{messageContent}}}
      </div>

      {{#if promoCode}}
      <div class="promo-card">
        <div class="label">Use Promo Code At Checkout</div>
        <div class="code">{{promoCode}}</div>
      </div>
      {{/if}}

      {{#if ctaUrl}}
      <div class="cta-wrapper">
        <a href="{{ctaUrl}}" class="cta-btn">Shop Now →</a>
      </div>
      {{/if}}

      <hr class="divider" />

      <p style="font-size: 13px; color: #9ca3af; text-align: center;">
        If you have any questions or feedback, feel free to reply directly to this email.
      </p>
    </div>

    <div class="footer">
      <p>© {{year}} {{shopName}}. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
